# ==============================================================
# BizPilot AI — Environment Configuration
# ==============================================================
PORT=5000
NODE_ENV=development

# --------------------------------------------------------------
# Real Gmail OTP Delivery Configuration:
#
# To send verification OTPs directly to any Gmail inbox:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password:
#    https://myaccount.google.com/apppasswords
#    (Select 'Mail' or 'Other' and name it 'BizPilot')
# 3. Paste your Gmail address and the 16-character App Password below:
# --------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: Custom From Sender Address (Must match your Gmail address or verified alias)
# FROM_EMAIL="BizPilot AI" <your_email@gmail.com>

# --------------------------------------------------------------
# Optional: Alternative Custom SMTP Relay (e.g. Brevo, SendGrid, Mailgun)
# If GMAIL_USER is left empty, the system will use SMTP_HOST instead:
# --------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
